# Copie este arquivo para ".env" e ajuste os valores.
# O arquivo ".env" NAO deve ser versionado (ja esta no .gitignore).
# Boa pratica de seguranca: segredos ficam fora do codigo-fonte.
#
# Como carregar estas variaveis no terminal (Linux/macOS):
#   export $(grep -v '^#' .env | xargs)

# --- Banco de dados ---------------------------------------------------------
# Escolha o perfil: h2 | postgres | mysql | custom
DB_PROFILE=postgres

# Dados de conexao (usados pelos perfis postgres, mysql e custom).
# Os exemplos abaixo combinam com o docker-compose.yml (PostgreSQL).
DB_URL=jdbc:postgresql://localhost:5432/carteira
DB_USERNAME=carteira
DB_PASSWORD=troque-esta-senha

# Apenas para o perfil "custom": classe do driver JDBC do seu SGBD.
# DB_DRIVER=com.microsoft.sqlserver.jdbc.SQLServerDriver

# --- Usuario inicial da aplicacao (demonstracao) ----------------------------
ADMIN_USERNAME=aluno
ADMIN_PASSWORD=senha123
